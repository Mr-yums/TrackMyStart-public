#!/usr/bin/env bash
# [Sol] Lanceur public portable ; identifiants fournis par l’environnement ou un .env local ignoré.
set -euo pipefail
cd "$(dirname "$0")/.."
python_bin="${PYTHON:-.venv/bin/python}"
command_name="${1:-run}"
if (( $# )); then shift; fi
case "$command_name" in
  run) exec "$python_bin" app.py "$@" ;;
  init) exec "$python_bin" -m flask --app app init-db "$@" ;;
  test) exec "$python_bin" -m pytest -q -m 'not live' "$@" ;;
  flask) exec "$python_bin" -m flask --app app "$@" ;;
  *) echo "Usage: scripts/trackmystart {run|init|test|flask} [arguments]" >&2; exit 2 ;;
esac
