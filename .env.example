# [Sol] Exemple sans secret ; configuration réelle via environnement ou coffre local.
# --- TrackMyStart ---
FLASK_ENV=development            # development | production
SECRET_KEY=change-me
DB_URL=sqlite:///instance/yumnews.db
SITE_URL=http://localhost:8800
SITE_NAME=TrackMyStart
TRUSTED_PROXY_HOPS=0  # 1 seulement derrière un proxy de confiance sans accès direct à l’application.

# --- Catalogue (APIs gratuites) ---
TMDB_API_KEY=
TMDB_LANGUAGE=fr-FR
TMDB_REGION=FR
CACHE_TTL_SECONDS=3600

# --- Abonnement ---
PAYMENTS_ENABLED=false  # Préinscriptions uniquement tant que le paiement n’est pas validé.
PREMIUM_PRICE_CENTS=2000          # tarif de base 20 € (réduit par les codes rabatteur/promo)
PREMIUM_PERIOD_DAYS=30
PREMIUM_CURRENCY=EUR

# --- Rabatage (coupons rabatteurs) ---
URSSAF_RATE_PERCENT=22            # base de calcul : commission = % (après URSSAF) du montant amené
AFFILIATE_COMMISSION_PERCENT=21   # commission par défaut d'un nouveau rabatteur (surchargeable par rabatteur)

# --- Factures (mentions émetteur) ---
INVOICE_ISSUER_NAME=             # défaut : SITE_NAME
INVOICE_ISSUER_ADDRESS=          # ex : 12 rue Exemple, 75000 Paris, France
INVOICE_ISSUER_VAT=              # n° TVA intracommunautaire (FRxx…)
INVOICE_VAT_RATE=20

# --- Paiement Square (CB) ---
SQUARE_ENV=sandbox               # sandbox | production
SQUARE_ACCESS_TOKEN=             # ou SQUARE_ACCESS_TOKEN_sandbox / _production
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# --- Paiement NOWPayments (crypto, optionnel) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
TRACKMYSTART_SMTP_PASSWORD=
ADSENSE_ENABLED=false
ADSENSE_CLIENT=
ADS_CONFIG_PATH=instance/advertising.json
SENDGRID_API_KEY=
MAIL_FROM=no-reply@trackmystart.de
